# KORUAL Platform Environment
# Copy this file to .env.local for local development.

VITE_KORUAL_APP_NAME=KORUAL Platform
VITE_KORUAL_PUBLIC_MODE=true
VITE_KORUAL_REQUIRE_HTTPS=true
VITE_KORUAL_SESSION_TIMEOUT_MINUTES=30
VITE_KORUAL_SUPPORT_EMAIL=support@korual.com

# Browser-exposed values only. Never place an admin token or service key here.
VITE_KORUAL_API_BASE_URL=
VITE_KORUAL_SUPABASE_URL=
VITE_KORUAL_SUPABASE_ANON_KEY=

# Server-only secrets belong in backend/Vercel settings (never a VITE_ key).
# OPENAI_API_KEY=
# DATABASE_URL=
# JWT_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=

# Private automation integration (server only).
KORUAL_GAS_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
KORUAL_GAS_SECRET=replace-with-a-new-random-secret
# Use a distinct random secret of at least 32 UTF-8 bytes for authenticating
# trusted server-to-server callers. Do not send this token from a public browser.
KORUAL_INTERNAL_API_TOKEN=replace-with-a-separate-long-random-internal-token
KORUAL_SPREADSHEET_ID=1-XYUbU6Os5q7P_9qFnTFmkva3o0KhrgPHd-AyA6-bts
