# KORUAL Platform Environment
# Copy this file to .env.local for local development.

VITE_KORUAL_APP_NAME=KORUAL Platform
VITE_KORUAL_PUBLIC_MODE=true
VITE_KORUAL_REQUIRE_HTTPS=true
VITE_KORUAL_SESSION_TIMEOUT_MINUTES=30
VITE_KORUAL_SUPPORT_EMAIL=support@korual.com

# Backend/API endpoints. Do not put secret keys in Vite frontend env variables.
VITE_KORUAL_API_BASE_URL=
VITE_KORUAL_SUPABASE_URL=
VITE_KORUAL_SUPABASE_ANON_KEY=

# Server-only secrets must be configured in backend/Vercel project settings, not frontend code.
# OPENAI_API_KEY=
# DATABASE_URL=
# JWT_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=

# GitHub webhook ingestion.
GITHUB_WEBHOOK_SECRET=replace-with-a-new-random-secret

# Google Apps Script signal sync.
GOOGLE_SCRIPT_SHARED_SECRET=replace-with-a-new-random-secret
KORUAL_GAS_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
KORUAL_GAS_SECRET=replace-with-a-new-random-secret
KORUAL_SPREADSHEET_ID=1-XYUbU6Os5q7P_9qFnTFmkva3o0KhrgPHd-AyA6-bts

# Vercel/GitHub Actions deployment.
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
