# Server-only values. Never prefix these with NEXT_PUBLIC_ or VITE_.
KORUAL_GAS_URL=https://script.google.com/macros/s/REPLACE_WITH_NEW_DEPLOYMENT_ID/exec
KORUAL_GAS_SECRET=replace-with-a-new-random-secret

# Supabase backend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# App auth / CORS
ALLOWED_ORIGINS=https://your-production-domain.example
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=2h
MAX_FAIL=5
LOCK_MINUTES=15
REQUIRE_IP_ALLOWLIST=false
IP_ALLOWLIST=

# Frontend-only values (only if the browser talks to Supabase directly)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
